<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your account will be deleted on {{deletionDate}}</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #ffffff; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto;">
      <tr><td>{{> header}}</td></tr>
      <tr>
        <td style="padding: 32px;">
          <h1 style="color: #1a1a1a; font-size: 24px; font-weight: 600; margin: 0 0 24px 0; line-height: 1.3;">Your account will be deleted on {{deletionDate}}</h1>
          <p style="color: #333333; font-size: 16px; line-height: 1.6; margin: 0 0 16px 0;">Hello{{#if name}} {{name}}{{/if}},</p>
          <p style="color: #333333; font-size: 16px; line-height: 1.6; margin: 0 0 16px 0;">You asked us to delete your account. On {{deletionDate}} we will delete your account and all your data. You have been logged out everywhere.</p>
          {{#if subscriptionCancelled}}
          <p style="color: #333333; font-size: 16px; line-height: 1.6; margin: 0 0 16px 0;">Your subscription was cancelled today.</p>
          {{/if}}
          <div style="text-align: center; margin: 32px 0;">
            <a href="{{keepUrl}}" style="display: inline-block; background: #1a1a1a; color: #ffffff; padding: 14px 28px; text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 16px;">Keep my account</a>
          </div>
          <p style="color: #333333; font-size: 16px; line-height: 1.6; margin: 0 0 16px 0;">Logging in also keeps it. If you did not ask for this, press the button and change your password.</p>
        </td>
      </tr>
      <tr><td>{{> footer}}</td></tr>
    </table>
  </body>
</html>
