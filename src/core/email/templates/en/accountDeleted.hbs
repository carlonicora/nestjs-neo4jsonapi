<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your account has been deleted</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #ffffff; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto;">
      <tr><td>{{> header}}</td></tr>
      <tr>
        <td style="padding: 32px;">
          <h1 style="color: #1a1a1a; font-size: 24px; font-weight: 600; margin: 0 0 24px 0; line-height: 1.3;">Your account has been deleted</h1>
          <p style="color: #333333; font-size: 16px; line-height: 1.6; margin: 0 0 16px 0;">Hello{{#if name}} {{name}}{{/if}},</p>
          <p style="color: #333333; font-size: 16px; line-height: 1.6; margin: 0 0 16px 0;">Your account and all your data have been deleted. This is the last email we send to this address.</p>
          <p style="color: #333333; font-size: 16px; line-height: 1.6; margin: 0 0 16px 0;">Your invoices stay with Stripe, our payment provider, because the law requires it.</p>
          <p style="color: #333333; font-size: 16px; line-height: 1.6; margin: 0 0 16px 0;">You are always welcome to sign up again.</p>
        </td>
      </tr>
      <tr><td>{{> footer}}</td></tr>
    </table>
  </body>
</html>
